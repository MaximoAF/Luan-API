generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Perfume {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  name        String
  family      String
  fam         String   // slug corto para el CSS: floral | amaderado | citrico | oriental | fresco
  topNotes    String
  heartNotes  String
  baseNotes   String
  description String
  imageUrl    String? 
  price       Int
  offerPrice  Int?
  stock       Int      @default(0)
  maxStock    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProximoIngreso {
  id          Int      @id @default(autoincrement())
  name        String
  family      String
  fam         String
  eta         String   // texto libre: "Mediados de agosto", "Fin de mes", etc.
  description String
  createdAt   DateTime @default(now())
}
